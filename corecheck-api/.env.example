# Copia a .env local o exporta en la shell antes de `npm run dev`.
# PowerShell:
#   $env:CORECHECK_API_KEY="cc_dev_local"
#   npm run dev
#
# Staging (Fly/Render + Neon) — ver docs/STAGING_DEPLOY.md:
#   CORECHECK_PERSISTENCE=postgres
#   DATABASE_URL=postgresql://...
#   CORECHECK_REPORT_HMAC_SECRET=<random>
#   CORECHECK_RETENTION_DAYS=90

CORECHECK_API_KEY=cc_dev_local
CORECHECK_PERSISTENCE=file
# CORECHECK_PERSISTENCE=postgres
# DATABASE_URL=postgres://corecheck:corecheck@localhost:5432/corecheck_api
# CORECHECK_REPORT_HMAC_SECRET=
# CORECHECK_RETENTION_DAYS=90
# PORT=3000

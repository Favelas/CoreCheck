{
  "name": "corecheck",
  "version": "1.0.0",
  "description": "CoreCheck - Automated SecOps & QA Audit Engine",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "corecheck": "dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "audit": "tsx src/cli/index.ts",
    "audit:sample": "tsx src/cli/index.ts --url https://example.com --fail-on HIGH --formats json,html,sarif,markdown --output-dir ./audit-results",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "commander": "^15.0.0",
    "pdfkit": "^0.19.1",
    "playwright": "^1.42.0"
  }
}
